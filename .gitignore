# App outputs that belong to CI/artifact storage, not VCS
*.apk
*.aab
*.ap_
*.idsig
output.json
output-metadata.json

# Firebase / crash reporting configs with per-project identifiers
google-services.json
fabric.properties

# Profiling dumps
*.hprof
*.trace

